{
    // IntelliSense: editore capraz derleyiciyi (cross compiler) tanitiyoruz,
    // boylece kod tamamlama PC'nin degil RISC-V hedefinin tanimlarini kullanir.
    //
    // Iki konfigurasyon var; sag alttaki durum cubugundan secilir:
    //   QEMU-virt : varsayilan, F5 ile debug edilen hedef
    //   RTG4-MiV  : platform.h'nin RTG4 blogu "aktif" gorunsun diye
    //
    // NOT: toolchain surumu (15.2.0-1.1) yolun icinde. tools\setup.ps1 bunu
    //      kurulu surume gore otomatik gunceller.
    "version": 4,
    "configurations": [
        {
            "name": "QEMU-virt",
            "compilerPath": "${env:APPDATA}/xPacks/@xpack-dev-tools/riscv-none-elf-gcc/15.2.0-1.1/.content/bin/riscv-none-elf-gcc.exe",
            "compilerArgs": [
                "-march=rv32imac_zicsr_zifencei",
                "-mabi=ilp32",
                "-ffreestanding"
            ],
            "includePath": [ "${workspaceFolder}/**" ],
            "defines": [ "PLATFORM_QEMU_VIRT" ],
            "cStandard": "c11",
            "intelliSenseMode": "gcc-x86",
            "browse": {
                "path": [ "${workspaceFolder}" ],
                "limitSymbolsToIncludedHeaders": true
            }
        },
        {
            "name": "RTG4-MiV",
            "compilerPath": "${env:APPDATA}/xPacks/@xpack-dev-tools/riscv-none-elf-gcc/15.2.0-1.1/.content/bin/riscv-none-elf-gcc.exe",
            "compilerArgs": [
                "-march=rv32imac_zicsr_zifencei",
                "-mabi=ilp32",
                "-ffreestanding"
            ],
            "includePath": [ "${workspaceFolder}/**" ],
            "defines": [ "PLATFORM_RTG4_MIV" ],
            "cStandard": "c11",
            "intelliSenseMode": "gcc-x86",
            "browse": {
                "path": [ "${workspaceFolder}" ],
                "limitSymbolsToIncludedHeaders": true
            }
        }
    ]
}
